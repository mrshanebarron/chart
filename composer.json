{
    "name": "mrshanebarron/chart",
    "description": "Charting component for Laravel - supports Livewire and Vue with Chart.js",
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "Shane Barron", "email": "mrshanebarron@gmail.com"}],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MrShaneBarron\\Chart\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["MrShaneBarron\\Chart\\ChartServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}
